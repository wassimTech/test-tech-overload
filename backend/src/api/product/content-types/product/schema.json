{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "Product",
    "description": "Vinyl catalog entry scoped to tenant"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "required": true
    },
    "productType": {
      "type": "enumeration",
      "enum": ["vinyl"],
      "default": "vinyl",
      "required": true
    },
    "title": {
      "type": "string",
      "required": true
    },
    "artist": {
      "type": "string",
      "required": true
    },
    "description": {
      "type": "text"
    },
    "label": {
      "type": "string",
      "required": true
    },
    "year": {
      "type": "integer",
      "required": true
    },
    "country": {
      "type": "string",
      "required": true
    },
    "format": {
      "type": "string",
      "required": true
    },
    "barcode": {
      "type": "string"
    },
    "discogsReleaseId": {
      "type": "string"
    },
    "discogsMasterId": {
      "type": "string"
    }
  }
}
