{
  "kind": "collectionType",
  "collectionName": "sellable_units",
  "info": {
    "singularName": "sellable-unit",
    "pluralName": "sellable-units",
    "displayName": "Sellable Unit",
    "description": "Physical inventory unit scoped to tenant and product"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "tenant": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::tenant.tenant",
      "required": true
    },
    "product": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::product.product",
      "required": true
    },
    "sku": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "currency": {
      "type": "string",
      "default": "EUR",
      "required": true
    },
    "discCondition": {
      "type": "enumeration",
      "enum": [
        "Mint",
        "Near Mint",
        "Very Good Plus",
        "Very Good",
        "Good Plus",
        "Good",
        "Fair",
        "Poor"
      ],
      "required": true
    },
    "sleeveCondition": {
      "type": "enumeration",
      "enum": [
        "Mint",
        "Near Mint",
        "Very Good Plus",
        "Very Good",
        "Good Plus",
        "Good",
        "Fair",
        "Poor"
      ],
      "required": true
    },
    "sellerNotes": {
      "type": "text"
    },
    "status": {
      "type": "enumeration",
      "enum": ["available", "reserved", "sold", "out_of_stock", "archived"],
      "default": "available",
      "required": true
    },
    "quantity": {
      "type": "integer",
      "default": 1,
      "required": true
    },
    "location": {
      "type": "string"
    }
  }
}
