# ==============================================================================
# Marketplace Connectors (Discogs)
# ==============================================================================
# Set to 'true' to use the offline deterministic mock connector (default for dev/tests).
# Set to 'false' to enable live requests to the official Discogs API (https://api.discogs.com).
DISCOGS_MOCK_MODE=true

# Optional: Personal Access Token for Discogs API authentication.
# Required only when DISCOGS_MOCK_MODE=false.
# Generate your token at: https://www.discogs.com/settings/developers
DISCOGS_API_TOKEN=

# User-Agent header string sent with Discogs API requests (Discogs requires a custom User-Agent)
DISCOGS_USER_AGENT=VinylBackoffice/1.0.0

